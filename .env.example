# ─────────────────────────────────────────────
#  Audio-to-Text — Environment Variables Template
#  Copy this file to .env and fill in real values.
#  NEVER commit the real .env file.
# ─────────────────────────────────────────────

# ── OpenAI (Whisper) ──
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Clerk (Auth) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REDACTED
CLERK_SECRET_KEY=sk_test_REDACTED
CLERK_WEBHOOK_SECRET=whsec_REDACTED
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── Supabase (Database + Storage) ──
# Use the SESSION POOLER connection string (IPv4) from Supabase → Connect.
# The direct db.<ref>.supabase.co host is IPv6-only on the free tier.
# URL-encode any special chars in the password (e.g. ! @ # -> %21 %40 %23).
DATABASE_URL=postgresql://postgres.xxxxxxxx:password@aws-0-<region>.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Upstash Redis (Queue for BullMQ) ──
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
# BullMQ needs a native TCP/TLS connection (not the REST API above).
# Upstash's free-tier Redis reuses the REST token as the TCP password:
# rediss://default:<UPSTASH_REDIS_REST_TOKEN>@<host-without-https>:6379
REDIS_URL=rediss://default:xxxxxxxxxxxxxxxxxxxxxxxx@xxxxxxxx.upstash.io:6379

# ── App config ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Stripe (Payments) — DEFERRED, add later ──
# STRIPE_SECRET_KEY=sk_test_REDACTED
# STRIPE_WEBHOOK_SECRET=whsec_REDACTED
