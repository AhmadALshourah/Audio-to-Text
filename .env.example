# ─────────────────────────────────────────────
#  Audio-to-Text — Environment Variables Template
#  Copy this file to .env and fill in real values.
#  NEVER commit the real .env file.
#
#  Fully self-contained: SQLite + local storage + self-built auth.
#  Only two external dependencies: OpenAI (Whisper) and Resend (transactional
#  email — password reset, email verification).
# ─────────────────────────────────────────────

# ── OpenAI (Whisper) ──
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Resend (transactional email: password reset, email verification) ──
# Get a key at https://resend.com/api-keys. EMAIL_FROM must be either
# Resend's shared sandbox sender (onboarding@resend.dev — works with no setup,
# but only delivers to the account's own verified address) or an address on a
# domain you've verified with Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Audio→Text <onboarding@resend.dev>

# ── Database (SQLite — single local file, resolved relative to
#    packages/db/prisma/). Create it with: pnpm --filter @audio-to-text/db db:push
DATABASE_URL=file:./dev.db

# ── Local audio storage (absolute path; shared by web + worker) ──
# Where uploaded audio is written temporarily before transcription.
UPLOADS_DIR=/absolute/path/to/repo/data/uploads

# ── App config ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
