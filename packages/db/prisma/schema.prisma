// ─────────────────────────────────────────────────────────────
//  Tadween — data model
//
//  Self-contained stack: SQLite (single file, no external DB).
//  SQLite has no native enums, so status/plan are String columns whose
//  allowed values live in packages/shared/src/types.ts (the single source
//  of truth, shared across db/web/worker).
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // e.g. file:./dev.db
}

// ── Models ─────────────────────────────────────────────────────

/// An authenticated user. Auth is self-built (no external provider):
/// `passwordHash` is a scrypt hash, sessions live in the Session table.
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  passwordHash    String
  // Null until the address is confirmed via a verification link. Informational
  // only — nothing is gated on this (a typo'd email just won't verify).
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subscription            Subscription?
  transcriptions          Transcription[]
  usageLogs               UsageLog[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([createdAt])
}

/// A one-time password-reset token. The raw value is emailed to the user;
/// only its SHA-256 hash is stored (same pattern as Session's tokenHash), so
/// a database leak never exposes a usable reset link. Single-use: deleted
/// once consumed (or once superseded by a newer request).
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A one-time email-verification token, sent on signup and whenever a user
/// changes their email. Same tokenHash-only-storage pattern as
/// PasswordResetToken. Single-use: deleted once consumed or superseded.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A logged-in session. The cookie holds a random token; we store only its
/// SHA-256 hash here, so a database leak never exposes live session tokens.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One row per user. Created (defaulting to `free`) when the user signs up.
/// No payment gateway — free-only by design. `plan`/`status` are String
/// (allowed values in packages/shared) and drive the quota system.
model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   String @default("free") // SubscriptionPlan: free | pro
  status String @default("active") // SubscriptionStatus: active | canceled | past_due

  // Billing / quota window — drives the monthly minute-quota reset.
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A single audio→text job. Drives the queue: created as `pending`, the
/// worker (which polls this table) claims it → `processing` → `done`/`failed`.
model Transcription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status String @default("pending") // TranscriptionStatus: pending | processing | done | failed

  fileName String
  // Path on the local uploads disk, set at creation; cleared (and the file
  // deleted) once the job finishes — we keep only the text long-term.
  audioPath       String?
  fileSizeBytes   Int
  durationSeconds Int? // audio length; null until transcribed
  language        String? // detected language code

  text         String? // result; null until done
  // JSON-encoded TranscriptSegment[] (packages/shared) — SQLite has no native
  // JSON column type, so we store it as text and (de)serialize in code. Used
  // to generate SRT/VTT subtitle files on demand. Null until done.
  segmentsJson String?
  errorMessage String? // populated only on failure

  // Estimated OpenAI cost of this transcription, filled in once done.
  costUsd Float?

  // Retry bookkeeping for the polling worker.
  attempts Int @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  usageLog UsageLog?

  @@index([userId, createdAt])
  @@index([status])
}

/// Immutable audit record of consumed audio time, used to enforce the
/// monthly quota. Source of truth for usage; aggregate rows within a
/// subscription period to compute consumption.
model UsageLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transcriptionId String        @unique
  transcription   Transcription @relation(fields: [transcriptionId], references: [id], onDelete: Cascade)

  seconds Int // audio seconds billed for this transcription

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
